# Copy this file to .env and replace both placeholder secrets before startup.
POSTGRES_DB=codeprogress
POSTGRES_USER=codeprogress
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST_PORT=5433

BACKEND_HOST_PORT=8080
APP_TIME_ZONE=UTC
LOG_LEVEL=INFO

# HS256 requires at least 32 bytes. Use a long random value outside version control.
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
JWT_ISSUER=codeprogress-api
JWT_ACCESS_TOKEN_TTL=PT1H
SWAGGER_ENABLED=true
